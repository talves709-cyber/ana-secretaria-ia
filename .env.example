# Copie para .env e troque todos os valores "troque-..." (gere com: openssl rand -hex 32)

# Postgres (banco "ana"; o Evolution usa o schema evolution_api dentro dele)
POSTGRES_USER=ana
POSTGRES_PASSWORD=troque-senha-postgres

# Evolution API
EVOLUTION_API_KEY=troque-chave-evolution
EVOLUTION_PUBLIC_URL=http://evolution:8080
EVOLUTION_INSTANCE=ana

# App da Ana
PORT=3100
# Endereço que o Evolution usa para chamar o webhook (rede interna do Docker)
WEBHOOK_URL=http://app:3100/webhook/evolution
# Token secreto enviado pelo Evolution no cabeçalho x-ana-token
WEBHOOK_TOKEN=troque-token-webhook
# Senha da página /conexao (usuário: qualquer nome)
PAINEL_SENHA=troque-senha-painel
# Quantos eventos o worker processa em paralelo
WORKER_CONCURRENCY=5

# Fase 2
ANTHROPIC_API_KEY=
# Modelo e esforço do classificador (low economiza tokens)
CLAUDE_MODELO=claude-opus-5-5
CLAUDE_ESFORCO=low
# Quantas conversas são classificadas em paralelo
CLASSIFICADOR_CONCORRENCIA=2
