{
  "name": "ana-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "tsx watch src/main.ts",
    "migrate": "tsx src/migrate.ts",
    "instancia:criar": "tsx scripts/criar-instancia.ts",
    "qrcode": "tsx scripts/qrcode.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "bullmq": "^6.4.0",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
